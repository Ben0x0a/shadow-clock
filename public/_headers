# Cloudflare Pages response headers for ShadowClock.
# WHY: the app handles case data entirely client-side; a strict CSP guarantees no script
# can exfiltrate it. The only third-party request allowed is OpenStreetMap tiles (opt-in).
# Referrer: OSM's tile policy expects a Referer; strict-origin-when-cross-origin sends only
# the site origin (the URL fragment carrying case data is never sent by browsers).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; worker-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
