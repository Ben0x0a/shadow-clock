{
  "name": "shadowclock",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ShadowClock — time and place from shadows. Built on static-web-platform; public/ is what ships.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "swp build",
    "check": "swp check",
    "verify": "swp verify",
    "gate": "swp gate",
    "icons": "swp icons",
    "serve": "swp serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "static-web-platform": "file:platform",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/leaflet": "1.9.22",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
